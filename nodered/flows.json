  {
    "id": "diep_ack_router",
    "type": "function",
    "z": "f6f2187d.f17ca8",
    "name": "ack -> FastAPI",
    "func": "var ack = msg.payload;\nif (typeof ack === 'string') { try { ack = JSON.parse(ack); } catch (e) { node.error('bad ack json', msg); return null; } }\nif (!ack || !ack.command_id) { node.error('ack missing command_id', msg); return null; }\nmsg.method = 'POST';\nmsg.url = 'http://diep-fastapi:8000/commands/' + ack.command_id + '/ack';\nmsg.headers = { 'content-type': 'application/json' };\nmsg.payload = { status: ack.status, error: ack.error || null };\nnode.status({ fill: 'green', shape: 'dot', text: ack.status + ' ' + ack.command_id });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
