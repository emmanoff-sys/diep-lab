{
  "uid": "diep-postgres-timescaledb",
  "title": "DIEP PostgreSQL / TimescaleDB",
  "tags": ["diep", "postgres", "timescaledb"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Active connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_stat_database_numbackends{datname=\"diep\"}",
          "legendFormat": "connections ({{datname}})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Database size",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_database_size_bytes{datname=\"diep\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transaction rate (commit/rollback)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(pg_stat_database_xact_commit{datname=\"diep\"}[5m])",
          "legendFormat": "commits/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"diep\"}[5m])",
          "legendFormat": "rollbacks/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top queries by total exec time (pg_stat_statements)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, pg_stat_statements_top_total_exec_seconds)",
          "format": "table",
          "instant": true,
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Mean query exec time (pg_stat_statements, top queries)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_stat_statements_top_mean_exec_seconds",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Hypertable size (telemetry)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "timescaledb_hypertable_total_bytes",
          "legendFormat": "{{hypertable_name}} total bytes"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Hypertable chunks",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "timescaledb_hypertable_num_chunks",
          "legendFormat": "{{hypertable_name}} chunks"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Compression ratio (before vs after, telemetry)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "timescaledb_compression_before_bytes",
          "legendFormat": "{{hypertable_name}} before compression"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "timescaledb_compression_after_bytes",
          "legendFormat": "{{hypertable_name}} after compression"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Compressed chunks / total chunks",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "timescaledb_compression_compressed_chunks",
          "legendFormat": "{{hypertable_name}} compressed"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "timescaledb_compression_total_chunks",
          "legendFormat": "{{hypertable_name}} total"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Postgres exporter up",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_up",
          "legendFormat": "pg_up"
        }
      ]
    }
  ]
}
