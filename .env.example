# DIEP secrets — Phase 9J (S0 secrets management).
#
# Copy to `.env` (gitignored) and OVERRIDE every value before any non-lab use.
# The code ships with lab DEFAULTS so the stack runs out of the box; those
# defaults are NOT secret and MUST be rotated for staging/production.
#
# Wiring: reference these in the docker-compose service `environment:` blocks
# (or `env_file: .env`) for fastapi, ingestor, dispatcher, and portal.

# --- API authentication (FastAPI) ---
DIEP_AUTH_ENFORCED=1                         # set 0 to disable enforcement (staging only)
DIEP_JWT_SECRET=change-me-to-a-long-random-string
DIEP_JWT_TTL=3600

# Machine-client + API keys (rotate!). Service token = ingestor/dispatcher;
# operator/admin keys = API actuation; portal token = the console BFF.
DIEP_SERVICE_TOKEN=change-me-service-token
DIEP_OPERATOR_KEY=change-me-operator-key
DIEP_ADMIN_KEY=change-me-admin-key
DIEP_PORTAL_TOKEN=change-me-admin-key        # portal injects this (admin-scoped)

# User logins for /auth/token (JWT issuance)
DIEP_ADMIN_USER=admin
DIEP_ADMIN_PASSWORD=change-me-admin-password
DIEP_OPERATOR_PASSWORD=change-me-operator-password
DIEP_VIEWER_PASSWORD=change-me-viewer-password

# Phase 12 — per-tenant operator logins (multi-tenancy demo: acme-op/globex-op).
# Named explicitly in the Installation Guide §7 pre-install checklist — rotate
# alongside the logins above.
DIEP_ACME_PASSWORD=change-me-acme-password
DIEP_GLOBEX_PASSWORD=change-me-globex-password

# --- Datastore credentials (rotate the exposed defaults) ---
DB_HOST=diep-timescaledb
DB_NAME=diep
DB_USER=diep
DB_PASSWORD=change-me-db-password            # also consumed directly by
                                              # docker-compose.yml's timescaledb
                                              # service (POSTGRES_PASSWORD) via
                                              # variable substitution from this
                                              # file — keep in sync automatically,
                                              # do not hardcode elsewhere

# --- MinIO (rotate 'admin/diep12345') ---
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# --- MQTT (rotate 'device-pass-2026' / 'nodered-pass-2026'); see S3/S4 for mTLS) ---
# Used by scripts/bootstrap-pki.sh to generate mosquitto/config/passwd for the
# legacy password-auth users in mosquitto/config/acl (diep-device, diep-nodered).
# The mTLS device/service identities (8883) are certificate-based and do not use
# these credentials — see §6.1 / scripts/bootstrap-pki.sh.
MQTT_USER=diep-device
MQTT_PASS=change-me-device-password
MQTT_NODERED_PASS=change-me-nodered-password

# --- Redis (Phase 15A: requirepass enabled — rotate this) ---
REDIS_PASSWORD=change-me-redis-password
