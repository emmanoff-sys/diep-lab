# .env.example — copy to .env and set real values before running locally.
# Never commit .env to version control.

SERVICE_NAME=service-name
DEBUG=false
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/service_db
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_SECRET_KEY=change-me-in-production-use-at-least-32-random-bytes
JWT_ALGORITHM=HS256
