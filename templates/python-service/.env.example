# .env.example — copy to .env and set real values before running locally.
# Never commit .env to version control.

SERVICE_NAME=service-name
DEBUG=false
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/service_db
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_SECRET_KEY=change-me-in-production-use-at-least-32-random-bytes
JWT_ALGORITHM=HS256

# --- docker-compose.yml local dev stack (WP-003-02) -------------------------
# Local-only credentials — SECURITY: never reuse these values in any other
# environment (Shared Dev, Staging, Production, etc.). See DOCKER_STANDARDS.md.
POSTGRES_PASSWORD=reos_local_dev
SCAFFOLD_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
